# Example environment variables (no secrets here)
# Copy to .env and fill real values in your local environment or CI secrets manager

# ==== MONGODB CONFIGURATION ====
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_MONGO_ROOT_PASSWORD
MONGO_INITDB_DATABASE=realestate

# Backend MongoDB connection string (do not commit real credentials)
MONGODB_URI=mongodb://<user>:<password>@<host>:27017/<database>?authSource=<authDB>

# ==== MONGO EXPRESS (Web UI for MongoDB) ====
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=CHANGE_ME_MONGO_EXPRESS_PASSWORD

# ==== REDIS CONFIGURATION ====
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Backend Redis connection string
REDIS_URL=redis://:<password>@<host>:6379

# ==== REDIS COMMANDER (Web UI for Redis) ====
REDIS_COMMANDER_HTTP_USER=admin
REDIS_COMMANDER_HTTP_PASSWORD=CHANGE_ME_REDIS_COMMANDER_PASSWORD

# ==== CLOUDINARY CONFIGURATION ====
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>

# ==== GOOGLE MAPS API KEY ====
GOOGLE_MAPS_API_KEY=CHANGE_ME_GOOGLE_MAPS_API_KEY

# ==== BACKEND CONFIGURATION ====
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
SESSION_SECRET=CHANGE_ME_SESSION_SECRET_MIN_32_CHARS
# .env.example (fragment do uzupełnienia)

# MongoDB root
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_INITDB_DATABASE=realestate

# MongoDB app user (do inicjalizacji przez init-user.sh)
MONGO_APP_USER=realestate_user
MONGO_APP_PASSWORD=supersecret

# Redis
REDIS_PASSWORD=changeme

# Backend
SESSION_SECRET=changeme
JWT_SECRET=changeme
CLIENT_URL=http://localhost:3000
CLOUDINARY_URL=cloudinary://key:secret@cloud

# mongo-express (dev only)
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=changeme

# redis-commander (dev only)
REDIS_COMMANDER_HTTP_USER=admin
REDIS_COMMANDER_HTTP_PASSWORD=changeme

# DOMAIN=twoja-domena.pl
